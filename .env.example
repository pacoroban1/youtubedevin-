# Amharic Recap Autopilot - Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# Google Gemini API (Required for EVERYTHING: Script, TTS, Image)
# ===========================================
# Get this from Google AI Studio: https://aistudio.google.com/
# Must have access to gemini-2.0-flash, gemini-2.0-flash-exp-image-generation (or imagen), and TTS models.
GEMINI_API_KEY=your_gemini_api_key_here
# Gemini TTS voice name (prebuilt voices). Examples: Puck, Kore, Aoede, Charon, Fenrir, Leda
GEMINI_TTS_VOICE_NAME=Puck

# ===========================================
# TTS Provider (Optional)
# ===========================================
# Default behavior:
# - If ELEVENLABS_API_KEY + ELEVENLABS_VOICE_ID are set, runner prefers ElevenLabs.
# - Else it uses Gemini TTS.
#
# You can force a provider explicitly:
#   TTS_PROVIDER=elevenlabs
#   TTS_PROVIDER=gemini
TTS_PROVIDER=
# Sample rate for generated/converted WAV (Hz)
TTS_SAMPLE_RATE=24000
# Hard caps to keep TTS calls bounded
TTS_MAX_CHARS=8000
TTS_PREVIEW_MAX_CHARS=600

# Narration loudness normalization (ffmpeg loudnorm)
NARRATION_TARGET_LUFS=-16
NARRATION_TRUE_PEAK=-1.5
NARRATION_LRA=11

# ElevenLabs (Optional)
ELEVENLABS_API_KEY=
# Voice ID from your ElevenLabs voice (e.g. your Remix voice)
ELEVENLABS_VOICE_ID=
# Recommended multilingual model for Amharic
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_TIMEOUT_S=60
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY_BOOST=0.75
ELEVENLABS_STYLE=0.1
ELEVENLABS_USE_SPEAKER_BOOST=true

# ===========================================
# YouTube Data API (Optional but recommended for auto-upload)
# ===========================================
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_API_KEY=
# Upload privacy default: public | unlisted | private
YOUTUBE_PRIVACY_STATUS=public

# ===========================================
# Scout (Optional, No-API RSS mode)
# ===========================================
# If you do NOT want to use YouTube Data API for discovery, you can run Scout via RSS.
# Provide a curated list of channel IDs (UC...) for recap channels you want to monitor.
#
# Comma/space-separated:
#   SCOUT_CHANNEL_IDS=UCxxxx UCyyyy,UCzzzz
SCOUT_CHANNEL_IDS=

# ===========================================
# Autopilot fallback (Optional)
# ===========================================
# If Scout fails (quota/no candidates), the pipeline can fall back to these IDs/URLs.
# Examples:
#   BACKLOG_VIDEO_IDS=abc123def45,xyz987uvw65
#   BACKLOG_VIDEO_IDS=https://www.youtube.com/watch?v=abc123def45 https://youtu.be/xyz987uvw65
BACKLOG_VIDEO_IDS=

# ===========================================
# Script Generation Settings
# ===========================================
# Narrator persona for style pass
NARRATOR_PERSONA=futuristic captain
# Beat size for recap translation/stylization (seconds per beat)
SCRIPT_BEAT_SECONDS=20
SCRIPT_MAX_BEATS=60
# Script quality loop (optional; controls retries/cost)
SCRIPT_QUALITY_MIN=0.85
SCRIPT_MAX_ATTEMPTS=2

# ===========================================
# Audio Mix (Let Original Movie/Scene Audio Through)
# ===========================================
# How to mix audio in the renderer:
#   replace = narration replaces original audio entirely (legacy)
#   windows = original audio is muted/ducked except short "breathing" windows (recommended)
#   duck    = original audio always ducked under narration
AUDIO_MIX_MODE=windows

# Original audio gain outside windows (0.0-1.0). Lower = more muted.
# Default 0.0 fully mutes the source audio outside windows (recommended for recap sources).
ORIG_AUDIO_DUCK_GAIN=0.0
# Original audio gain during windows (0.0-1.0).
ORIG_AUDIO_FULL_GAIN=1.0

# Narration overall gain multiplier.
NARRATION_GAIN=1.0
# Narration gain during windows (0.0-1.0). Lower = let cast/ambience punch through.
NARRATION_DUCK_GAIN=0.15

# How many windows to infer from the script beats (used during script generation).
# Default 0 to keep the source audio fully muted unless you explicitly want windows.
ORIG_AUDIO_WINDOW_COUNT=0
# Approx window length in seconds (script-time, scaled to narration length at render time).
ORIG_AUDIO_WINDOW_SECONDS=2.8
# Fade in/out duration per window.
ORIG_AUDIO_FADE_SECONDS=0.25

# ===========================================
# Audio Quality Gates (Non-negotiable)
# ===========================================
# Detect "English bleed" near the end of the final mix and auto-retry render in replace mode.
NO_ENGLISH_BLEED_CHECK=1
ENGLISH_BLEED_PROB_THRESHOLD=0.60
BLEED_CHECK_WHISPER_MODEL=tiny

# Final mix loudness normalization (ffmpeg loudnorm)
FINAL_TARGET_LUFS=-14
FINAL_TRUE_PEAK=-1.5
FINAL_LRA=11

# ===========================================
# Translation (Optional)
# ===========================================
# If blank, Gemini handles translation internally.
# Supported values: google, libretranslate, none (or blank)
TRANSLATION_PROVIDER=
GOOGLE_CLOUD_API_KEY=
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# ===========================================
# Thumbnail Settings
# ===========================================
# ZThumb URL (Optional). If blank, uses Gemini/Imagen.
ZTHUMB_URL=
# Must remain false to avoid OpenAI costs.
ALLOW_THUMBNAIL_FALLBACK_TO_OPENAI=false

# ===========================================
# Database
# ===========================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=autopilot
POSTGRES_PASSWORD=autopilot_secret_password
POSTGRES_DB=amharic_recap

# ===========================================
# Other (Optional)
# ===========================================
OPENAI_API_KEY=
AZURE_SPEECH_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# ===========================================
# N8N
# ===========================================
# n8n basic auth (docker-compose.yml maps these into N8N_BASIC_AUTH_* inside the container)
N8N_USER=admin
N8N_PASSWORD=change_this_password

# Optional (recommended on a VM): set these so webhook URLs and links are correct.
# Examples:
#   N8N_HOST=203.0.113.10
#   WEBHOOK_URL=http://203.0.113.10:5678/
#   TIMEZONE=America/Los_Angeles
N8N_HOST=
WEBHOOK_URL=
TIMEZONE=UTC

# ===========================================
# Optional: Caddy reverse proxy (infra/gcp/docker-compose.caddy.yml)
# ===========================================
# If you have a domain, set CADDY_SITE=yourdomain.com for automatic HTTPS.
# If you do NOT have a domain, set CADDY_SITE=:80 (HTTP only).
CADDY_SITE=
CADDY_ACME_EMAIL=
# Generate bcrypt hash:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your_password'
CADDY_BASIC_AUTH_USER=
CADDY_BASIC_AUTH_HASH=
